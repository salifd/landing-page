Options -Indexes

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/* requests to the Slim front controller
  RewriteRule ^api(/.*)?$ api.php [QSA,L]

  # Serve statically exported Next.js pages without the .html extension
  # (e.g. /terms -> /terms.html). Checked before directories because the
  # export also creates a /terms/ folder holding client navigation data.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
