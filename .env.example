# SMTP Configuration (for backend email notifications)
# Use Brevo SMTP credentials or any other SMTP service
VITE_SMTP_Server=smtp-relay.brevo.com
VITE_SMTP_PORT=587
VITE_LOGIN=your-smtp-login@smtp-brevo.com
VITE_SMTP_PASS=your-smtp-password

# Email Configuration
# Email address that will receive waitlist notifications
VITE_EMAIL_TO=dagence.digital@gmail.com
# Email address that will be used as sender
VITE_EMAIL_FROM=hello@quikkupay.com

# API Configuration
# For development, use http://localhost:3001
# For production, use your deployed API URL (e.g., https://api.yourdomain.com)
VITE_API_URL=http://localhost:3001

# Server Port
# Port on which the backend API server will run
PORT=3001
