# Copy to .env next to docker-compose.yml on the server (never commit it), fill it in,
# then check it:  docker compose exec web node scripts/check-brevo.mjs --send-test
# These values are only read by the server; none of them reach the browser.

# Brevo API v3 key: Brevo > SMTP & API > API Keys. It starts with "xkeysib-".
# An SMTP key ("xsmtpsib-...") will NOT work: the site uses Brevo's REST API, not SMTP.
# If Brevo's "Authorised IPs" protection is on, add your server's public IP under
# Brevo > Security > Authorised IPs, otherwise every call is rejected.
BREVO_API_KEY=your-brevo-api-key-here

# ID of the contact list waitlist signups are added to (Brevo > Contacts > Lists)
BREVO_LIST_ID=1

# Sender of the notification email. Must be a verified sender (or on an authenticated
# domain) in Brevo > Senders, domains & dedicated IPs.
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME="Quikku Notifications"

# Who receives the "New Waitlist Subscription" alert
EMAIL_TO=admin@yourdomain.com
EMAIL_TO_NAME="Quikku Admin"
